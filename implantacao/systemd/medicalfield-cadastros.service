[Unit]
Description=MedicalField - cadastros e autenticação (Node.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=univates
Group=univates
WorkingDirectory=/opt/medicalfield/servicos/cadastros-node
EnvironmentFile=/etc/medicalfield/medicalfield.env
ExecStart=/usr/bin/node src/servidor.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
