# Copie para .env e preencha. O arquivo .env não vai para o git.

# Senha do usuário de banco de cada API
# API 1 - autenticação, logs e documentos (Python)
DB_SENHA_API1=
# API 2 - prontuários e sincronização (Go)
DB_SENHA_API2=
# API 3 - pessoas, medicamentos e atendimentos (Node)
DB_SENHA_API3=

# Senha dos profissionais fictícios criados pelo 003_seed.sql
SENHA_DEMO=

# Envio da ficha por e-mail (Gmail: usar "senha de app", não a senha da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=

# Segredo compartilhado pelos três serviços para assinar/validar o token
JWT_SEGREDO=
