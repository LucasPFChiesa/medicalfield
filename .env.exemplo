# Copie para .env e preencha. O arquivo .env não vai para o git.

# Senhas dos usuários de banco de cada microsserviço
DB_SENHA_CADASTROS=
DB_SENHA_ATENDIMENTOS=
DB_SENHA_SYNC=

# Senha dos profissionais fictícios criados pelo 003_seed.sql
SENHA_DEMO=

# Envio da ficha por e-mail (Gmail: usar "senha de app", não a senha da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=

# Segredo compartilhado pelos três serviços para assinar/validar o token
JWT_SEGREDO=
