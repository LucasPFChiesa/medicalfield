{
  "openapi": "3.0.3",
  "info": {
    "title": "MedicalField - API 2: Prontuários e sincronização (Go)",
    "version": "1.0.0",
    "description": "Prontuários (cadastro, consulta e edição com controle de versão) e sincronização bidirecional do app do socorrista. O push recebe a fila de operações feitas offline, garante idempotência pelo op_id, resolve conflitos de versão e grava o prontuário aqui mesmo e repassa pessoas e atendimentos à API 3. O pull devolve tudo que mudou desde um cursor. Todas as rotas exigem Authorization: Bearer <token>."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "bearer": [] }],
  "paths": {
    "/api/prontuario": {
      "get": {
        "tags": ["Prontuários"], "summary": "Obtém todos os prontuários de todas as pessoas",
        "parameters": [{ "name": "busca", "in": "query", "description": "Filtro pelo nome do paciente", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Lista", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Prontuario" } } } } }, "401": { "$ref": "#/components/responses/NaoAutenticado" } }
      },
      "post": {
        "tags": ["Prontuários"], "summary": "Cadastra um prontuário (um ativo por pessoa)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProntuarioEntrada" } } } },
        "responses": { "201": { "description": "Criado" }, "400": { "description": "Dados inválidos ou paciente inexistente" }, "409": { "description": "Paciente já possui prontuário ou id já existe" } }
      }
    },
    "/api/prontuario/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "description": "Id do prontuário ou id da pessoa", "schema": { "type": "string", "format": "uuid" } }],
      "get": { "tags": ["Prontuários"], "summary": "Obtém o prontuário de uma pessoa", "responses": { "200": { "description": "Prontuário" }, "404": { "description": "Não encontrado" } } },
      "put": {
        "tags": ["Prontuários"], "summary": "Cria ou atualiza o prontuário (id do prontuário), com controle de versão",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProntuarioEntrada" } } } },
        "responses": { "200": { "description": "Atualizado" }, "201": { "description": "Criado" }, "409": { "description": "versao_base diferente da atual; o registro atual vem em 'atual'" } }
      },
      "delete": { "tags": ["Prontuários"], "summary": "Exclusão lógica (somente admin)", "responses": { "200": { "description": "Excluído" }, "403": { "description": "Perfil sem permissão" }, "404": { "description": "Não encontrado" } } }
    },
    "/api/sync/push": {
      "post": {
        "tags": ["Sincronização"],
        "summary": "Envia operações pendentes do dispositivo (cliente → servidor)",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PedidoPush" } } }
        },
        "responses": {
          "200": { "description": "Resultado de cada operação", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RespostaPush" } } } },
          "400": { "description": "Pedido inválido" },
          "401": { "description": "Token ausente ou inválido" }
        }
      }
    },
    "/api/sync/pull": {
      "get": {
        "tags": ["Sincronização"],
        "summary": "Baixa os dados alterados depois do cursor (servidor → cliente)",
        "parameters": [{ "name": "desde", "in": "query", "description": "Último cursor recebido (0 na primeira vez)", "schema": { "type": "integer", "default": 0 } }],
        "responses": {
          "200": { "description": "Registros alterados e novo cursor", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RespostaPull" } } } }
        }
      }
    },
    "/api/sync/operacoes": {
      "get": {
        "tags": ["Sincronização"],
        "summary": "Rastro das operações recebidas (para o portal)",
        "parameters": [{ "name": "limite", "in": "query", "schema": { "type": "integer", "default": 100, "maximum": 500 } }],
        "responses": { "200": { "description": "Últimas operações" } }
      }
    },
    "/api/sync/operacoes/{id}": {
      "get": {
        "tags": ["Sincronização"],
        "summary": "Uma operação com a versão enviada pelo dispositivo e a versão que ficou no servidor",
        "parameters": [{ "name": "id", "in": "path", "required": true, "description": "op_id da operação", "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Operação com payload_cliente e payload_servidor" }, "404": { "description": "Operação não encontrada" } }
      }
    }

  },
  "components": {
    "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "responses": { "NaoAutenticado": { "description": "Token ausente, inválido ou expirado" } },
    "schemas": {
      "ProntuarioEntrada": {
        "type": "object", "required": ["paciente_id"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "description": "Opcional no POST" },
          "paciente_id": { "type": "string", "format": "uuid" },
          "tipo_sanguineo": { "type": "string", "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"] },
          "alergias": { "type": "string" },
          "comorbidades": { "type": "string" },
          "uso_continuo": { "type": "string" },
          "observacoes": { "type": "string" },
          "versao_base": { "type": "integer", "description": "Versão lida pelo cliente (PUT)" },
          "alterado_no_cliente_em": { "type": "string", "format": "date-time" }
        }
      },
      "Prontuario": {
        "allOf": [{ "$ref": "#/components/schemas/ProntuarioEntrada" }, { "type": "object", "properties": {
          "versao": { "type": "integer" }, "paciente_nome": { "type": "string" },
          "criado_em": { "type": "string", "format": "date-time" }, "excluido_em": { "type": "string", "format": "date-time", "nullable": true } } }]
      },
      "Operacao": {
        "type": "object",
        "required": ["op_id", "entidade", "acao", "entidade_id"],
        "properties": {
          "op_id": { "type": "string", "format": "uuid", "description": "Identificador único da operação (idempotência)" },
          "entidade": { "type": "string", "enum": ["paciente", "prontuario", "atendimento"] },
          "acao": { "type": "string", "enum": ["criar", "atualizar", "excluir"] },
          "entidade_id": { "type": "string", "format": "uuid" },
          "versao_base": { "type": "integer", "description": "Versão do registro quando foi editado no dispositivo (0 para registro novo)" },
          "dados": { "type": "object", "description": "Registro completo, no mesmo formato das APIs de cadastros/atendimentos" }
        }
      },
      "PedidoPush": {
        "type": "object",
        "required": ["dispositivo_id", "operacoes"],
        "properties": {
          "dispositivo_id": { "type": "string" },
          "operacoes": { "type": "array", "maxItems": 200, "items": { "$ref": "#/components/schemas/Operacao" } }
        }
      },
      "RespostaPush": {
        "type": "object",
        "properties": {
          "resultados": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op_id": { "type": "string" },
                "status": { "type": "string", "enum": ["aplicada", "duplicada", "conflito", "erro"] },
                "mensagem": { "type": "string" },
                "retentar": { "type": "boolean", "description": "true quando vale reenviar depois (falha temporária)" },
                "registro": { "type": "object", "description": "Versão do registro que ficou no servidor" }
              }
            }
          }
        }
      },
      "RespostaPull": {
        "type": "object",
        "properties": {
          "cursor": { "type": "integer" },
          "pacientes": { "type": "array", "items": { "type": "object" } },
          "prontuarios": { "type": "array", "items": { "type": "object" } },
          "medicamentos": { "type": "array", "items": { "type": "object" } },
          "atendimentos": { "type": "array", "items": { "type": "object" } },
          "profissionais": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
