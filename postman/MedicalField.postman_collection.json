        {
          "name": "POST /sync/push (ocorrência offline)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sync/push",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sync",
                "push"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dispositivo_id\": \"postman\",\n  \"operacoes\": [\n    {\n      \"op_id\": \"{{op_pessoa}}\",\n      \"entidade\": \"paciente\",\n      \"acao\": \"criar\",\n      \"entidade_id\": \"{{offline_pessoa}}\",\n      \"versao_base\": 0,\n      \"dados\": {\n        \"id\": \"{{offline_pessoa}}\",\n        \"nome\": \"Vítima via Postman\",\n        \"sexo\": \"M\",\n        \"alterado_no_cliente_em\": \"2026-10-13T15:00:00Z\"\n      }\n    },\n    {\n      \"op_id\": \"{{op_atendimento}}\",\n      \"entidade\": \"atendimento\",\n      \"acao\": \"criar\",\n      \"entidade_id\": \"{{offline_atendimento}}\",\n      \"versao_base\": 0,\n      \"dados\": {\n        \"id\": \"{{offline_atendimento}}\",\n        \"paciente_id\": \"{{offline_pessoa}}\",\n        \"data_hora\": \"2026-10-13T15:00:00Z\",\n        \"tipo_ocorrencia\": \"queda\",\n        \"descricao\": \"Registrado sem conexão (Postman).\",\n        \"manchester\": \"verde\"\n      }\n    }\n  ]\n}"
            },
            "description": "O script de pré-requisição gera ids novos. Rode 'Reenviar o mesmo push' em seguida para ver a idempotência."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "for (const v of ['op_pessoa','op_atendimento','offline_pessoa','offline_atendimento']) pm.collectionVariables.set(v, pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('aplicadas', () => pm.expect(pm.response.json().resultados.map(r => r.status)).to.eql(['aplicada','aplicada']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reenviar o mesmo push (duplicada)",
          "request": {
            "method": "POST",
