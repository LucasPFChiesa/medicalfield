{
  "info": {
    "name": "MedicalField",
    "description": "Rotas das três APIs do MedicalField (API 1 Python, API 2 Go, API 3 Node), na ordem em que dependem umas das outras. Rode primeiro 'POST /auth/login (admin)': o token fica guardado e as outras requisições o enviam como Bearer. Usuário admin, senha admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://medicalfield.duckdns.org/api"
    },
    {
      "key": "senha",
      "value": "admin"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "token_socorrista",
      "value": ""
